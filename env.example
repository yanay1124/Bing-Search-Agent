# LM Studio / OpenAI 相容 API
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.6-35b-a3b-uncensored-wasserstein

# 瀏覽器設定
# BROWSER_CHANNEL 可選：msedge（需安裝 Edge）或 chrome（需安裝 Chrome）
BROWSER_CHANNEL=msedge
# HEADLESS=false 表示真實瀏覽器（視窗會自動隱藏，需安裝 pywin32 psutil）
# HEADLESS=true  無頭模式，不需要 pywin32
HEADLESS=false

# 伺服器設定
HOST=127.0.0.1
PORT=61500

# User Agent（可選，留空使用預設值）
# USER_AGENT=
